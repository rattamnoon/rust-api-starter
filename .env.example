JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
LOG_DIR=./logs
UPLOAD_DIR=./uploads
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
